{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private visual reference reconstruction inventory",
  "type": "object",
  "required": ["schema_version", "input_sha256", "frame_bbox", "regions", "fully_editable_reproduction_verified"],
  "properties": {
    "schema_version": {"const": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_file": {"type": "string"},
    "synthetic_only": {"type": "boolean"},
    "frame_bbox": {"$ref": "#/$defs/bbox"},
    "regions": {"type": "array", "items": {"type": "object", "required": ["id", "bbox", "type", "confidence", "z_order"], "properties": {
      "id": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"},
      "type": {"enum": ["text", "shape", "image", "table", "chart", "unknown"]},
      "verbatim_text": {"type": "string"},
      "confidence": {"enum": ["low", "medium", "high"]},
      "z_order": {"type": "integer"},
      "manual_required": {"type": "boolean"},
      "font_pt_basis": {"enum": ["estimated", "verified_source", "user_specified"]}
    }}},
    "fully_editable_reproduction_verified": {"type": "boolean"},
    "review": {"type": "object"}
  },
  "$defs": {"bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}},
  "description": "BBox is x/y/width/height. Verify region/frame bounds and pixel/text/crop/perspective/aspect manually before reconstruction. Uncertain text, charts/tables or cropped boundaries are manual-required. No full-raster editability claim."
}
