{
  "schema_version": "2.0",
  "initial_state": "WAIT_TEMPLATE_DISPLAY",
  "states": {
    "WAIT_TEMPLATE_DISPLAY": {
      "allowed": [
        "catalog_refresh",
        "recommend_templates",
        "show_template_picker"
      ]
    },
    "WAIT_TEMPLATE_SELECTION": {
      "allowed": [
        "wait_for_template_choice",
        "show_template_details",
        "show_template_picker"
      ]
    },
    "WAIT_PRESET_SELECTION": {
      "allowed": [
        "rank_presets",
        "show_preset_picker",
        "wait_for_preset_choice"
      ]
    },
    "SELECTION_LOCKED": {
      "allowed": [
        "record_template_and_preset",
        "research",
        "verify_sources"
      ]
    },
    "RESEARCHING": {
      "allowed": [
        "research",
        "verify_sources",
        "build_storyline"
      ]
    },
    "WAIT_STORYLINE_APPROVAL": {
      "allowed": [
        "present_storyline",
        "revise_storyline",
        "wait_for_user_approval",
        "edit_storyline",
        "reorder_slides",
        "change_slide_count",
        "approve_storyline",
        "record_storyline_approval"
      ]
    },
    "GENERATING": {
      "allowed": [
        "initialize_project",
        "compose_content",
        "author_slides",
        "export_pptx"
      ]
    },
    "QA": {
      "allowed": [
        "verify_deck",
        "render_contact_sheet",
        "fix_generation_errors",
        "source_date_check"
      ]
    },
    "COMPLETE": {
      "allowed": [
        "deliver_pptx"
      ]
    }
  },
  "transitions": [
    {
      "from": "WAIT_TEMPLATE_DISPLAY",
      "to": "WAIT_TEMPLATE_SELECTION",
      "condition": "real registered template picker/previews were visibly provided"
    },
    {
      "from": "WAIT_TEMPLATE_SELECTION",
      "to": "WAIT_PRESET_SELECTION",
      "condition": "user explicitly returned a valid template id"
    },
    {
      "from": "WAIT_PRESET_SELECTION",
      "to": "SELECTION_LOCKED",
      "condition": "user explicitly returned a valid production preset id and gate-v3 template+preset selection is recordable"
    },
    {
      "from": "SELECTION_LOCKED",
      "to": "RESEARCHING",
      "condition": "template_selection.json gate v3 is valid"
    },
    {
      "from": "RESEARCHING",
      "to": "WAIT_STORYLINE_APPROVAL",
      "condition": "evidence review is complete and slide-by-slide storyline/content outline is ready"
    },
    {
      "from": "WAIT_STORYLINE_APPROVAL",
      "to": "GENERATING",
      "condition": "user explicitly approves the currently presented/edited slide-by-slide storyline and a matching storyline_approval.json evidence record exists"
    },
    {
      "from": "GENERATING",
      "to": "QA",
      "condition": "PPTX export completed"
    },
    {
      "from": "QA",
      "to": "COMPLETE",
      "condition": "owner-defined QA passes and final render sanity scan is acceptable"
    }
  ],
  "hard_stops": [
    "No explicit template selection",
    "No explicit production preset selection",
    "No valid gate-v3 template+preset selection evidence",
    "Invented template, preset, or preview",
    "Claimed visible UI without verifiable output",
    "Research attempted before template+preset lock",
    "Generation attempted before storyline approval",
    "Silent template or preset substitution after lock",
    "QA failure",
    "No valid storyline_approval.json matching the currently approved preview",
    "Storyline changed after approval without re-approval"
  ]
}
